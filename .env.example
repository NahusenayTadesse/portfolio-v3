# Copy to .env and fill in. Values live in the Vercel project settings.

# Firebase web app config (Project settings -> Your apps)
PUBLIC_API_KEY=
PUBLIC_AUTH_DOMAIN=
PUBLIC_PROJECT_ID=
PUBLIC_STORAGE_BUCKET=
PUBLIC_MESSAGING_SENDER_ID=
PUBLIC_APP_ID=
PUBLIC_MEASUREMENT_ID=

# Firebase service account, as a single-line JSON string
# (Project settings -> Service accounts -> Generate new private key)
FIREBASE_ADMIN_SDK_CONFIG=

# Contact form (Gmail + app password)
EMAIL=
APP_PASSWORD=

# Cloudinary (image uploads from /dashboard/create)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
